    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.2",
    "@playwright/test": "^1.63.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
