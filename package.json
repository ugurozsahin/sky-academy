{
  "name": "sky-ninja-academy",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build && vite build -c vite.sketchbook.config.ts && node scripts/build-sw.mjs",
    "preview": "vite preview --host --port 4173",
    "sketch": "vite -c vite.sketchbook.config.ts --host",
    "sketch:shot": "node scripts/sketch-shot.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:sketch": "playwright test --project=sketchbook",
    "test:all": "npm run test && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.2",
    "@playwright/test": "^1.63.0",
    "@types/three": "0.186.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "three": "0.186.1"
  }
}
