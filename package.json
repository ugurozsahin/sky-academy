{
  "name": "sky-ninja-academy",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/catalogue-slim.mjs",
    "dev": "vite --host",
    "prebuild": "node scripts/catalogue-slim.mjs",
    "build": "tsc --noEmit && vite build && vite build -c vite.sketchbook.config.ts && node scripts/build-sw.mjs",
    "preview": "vite preview --host --port 4173",
    "sketch": "vite -c vite.sketchbook.config.ts --host",
    "sketch:shot": "node scripts/sketch-shot.mjs",
    "lint": "eslint src tests/unit",
    "hooks": "git config core.hooksPath .githooks",
    "test": "vitest run",
    "content-map": "node scripts/content-map.mjs && node scripts/site-curriculum.mjs",
    "catalogue:slim": "node scripts/catalogue-slim.mjs",
    "catalogue:show": "node scripts/catalogue-slim.mjs && node scripts/catalogue-show.mjs",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --project=mobile --grep @smoke",
    "test:sketch": "playwright test --project=sketchbook",
    "test:all": "npm run test && npm run build && npm run test:e2e",
    "site:shots": "curl -sf http://localhost:4399/ >/dev/null && { echo 'site:shots: port 4399 is busy'; exit 1; }; npm run build && { ./node_modules/.bin/vite preview --port 4399 --strictPort & P=$!; trap 'kill $P 2>/dev/null' EXIT INT TERM; until curl -sf http://localhost:4399/ >/dev/null; do kill -0 $P 2>/dev/null || exit 1; sleep 1; done; node scripts/site-shots.mjs http://localhost:4399/ site-shots; }"
  },
  "devDependencies": {
    "@capacitor-community/text-to-speech": "8.0.2",
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/share": "^8.0.2",
    "@playwright/test": "^1.63.0",
    "@types/three": "0.186.0",
    "eslint": "10.11.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "8.71.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "three": "0.186.1"
  }
}
